{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && esbuild server.app.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.bundle.mjs",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/run_all.ts",
    "test:all": "tsx tests/run_all.ts && python3 backend/test_agentguard.py",
    "test:security": "tsx tests/security.test.ts",
    "test:efficiency": "tsx tests/efficiency.test.ts",
    "test:accessibility": "tsx tests/accessibility.test.ts",
    "test:problem-alignment": "tsx tests/problem_statement.test.ts",
    "test:code-quality": "tsx tests/code_quality.test.ts",
    "test:testing": "tsx tests/testing_validation.test.ts",
    "bench": "tsx scripts/run-benchmarks.ts",
    "bench:backend": "python3 backend/benchmark.py"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
